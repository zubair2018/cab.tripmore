# TripMore Cabs — Cloud Functions configuration
# =============================================================================
# Copy this file to "functions/.env" and fill in the values you have. Every
# value is OPTIONAL: a feature stays off until its keys are present, so you can
# ship payments first and switch notifications on later — no code changes.
#
#   cp functions/.env.example functions/.env
#
# functions/.env is git-ignored. Firebase loads it automatically at deploy.
# =============================================================================


# ── Razorpay (online payments) ───────────────────────────────────────────────
# These are SECRETS. You can either put them here in functions/.env, or (more
# secure) set them in Google Secret Manager instead:
#     firebase functions:secrets:set RAZORPAY_KEY_ID
#     firebase functions:secrets:set RAZORPAY_KEY_SECRET
#     firebase functions:secrets:set RAZORPAY_WEBHOOK_SECRET
# Find KEY_ID / KEY_SECRET in Razorpay Dashboard → Settings → API Keys.
# WEBHOOK_SECRET is a value you choose when creating the webhook.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=


# ── Email notifications (SMTP) ────────────────────────────────────────────────
# Works with any provider (Gmail, Zoho, Brevo, SendGrid, Mailgun, ...).
# Leave blank to disable email. Port 465 = SSL, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TripMore Cabs <bookings@yourdomain.com>
ADMIN_EMAIL=ops@yourdomain.com


# ── WhatsApp notifications (Meta WhatsApp Cloud API) ──────────────────────────
# Leave blank to disable WhatsApp. Requires a Meta app + two approved message
# templates (see NOTIFICATIONS_SETUP.md for the exact template text to create).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_LANG=en
WHATSAPP_CUSTOMER_TEMPLATE=booking_confirmed
WHATSAPP_ADMIN_TEMPLATE=new_booking_admin
ADMIN_WHATSAPP=919999999999


# ── Branding (optional) ───────────────────────────────────────────────────────
BUSINESS_NAME=TripMore Cabs
