# TripMore Cabs — Firebase configuration
#
# Copy this file to ".env" and fill in the values from your Firebase project
# (Project settings → General → Your apps → SDK setup and configuration).
# All six values are required; if any is missing the app runs in demo mode
# with default places and prices and no live bookings.

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
